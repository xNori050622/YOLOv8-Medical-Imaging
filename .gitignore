# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# ---- 虚拟环境 ----
venv/
.venv/
env/

# ---- IDE / 编辑器 ----
.vscode/
.idea/

# ---- Streamlit ----
.streamlit/secrets.toml

# ---- 凭据：一律不入库 ----
# Roboflow / Kaggle 的 token 都只该活在本地。以前把 key 贴在对话里的那次事故
# 说明这类东西一旦入库就永远留在历史里 (即使后来删除文件也没用)。
.env
.env.*
kaggle.json


# ---- 操作系统 / 临时文件 ----
Thumbs.db
.DS_Store
*.log
*.bak

# ---- ultralytics 数据集缓存：内容记录的是绝对路径，随数据位置变化即失效，
# ---- 用时会自动重建，不属于数据本身 ----
*.cache

# ---- 训练：基础（COCO 预训练）权重，体积大且可重新下载 ----
weights/*.pt
weights/*.pt.bak

# ---- 训练：数据集，体积大且需自行下载（见 README）----
detection/data/
classification/Covid19-dataset/
segmentation/Dataset_BUSI_with_GT/
segmentation/data/
segmentation/data_/
# tools/make_augmented_dataset.py 的默认输出位置（原图+增强，体积翻倍）
segmentation/data_aug/
segmentation/data.yaml

# ---- 训练产物：仓库里只保留原有的 runs/<task>/train/，其余重训输出不入库 ----
runs/*/smoke/
runs/*/train[0-9]*/

# ---- 导出模型（ONNX 等）：体积大且可由 best.pt 一条命令重新导出，
# ---- 所以不入库；权重本身（runs/<task>/train/weights/*.pt）仍然入库。
# ---- 重新导出的命令见 README「Export to ONNX」。
runs/*/train/weights/*.onnx

# ---- 评估产物：ultralytics val()（runs/<task>/val*/）与 evaluate.py --cross-check
# ---- 的输出（runs/cross_check_*/）都是可重新生成的，不入库 ----
runs/*/val*/
runs/cross_check_*/
# ---- evaluate.py --save 输出的指标 JSON 同样可重新生成，不入库。
# ---- 用 ** 覆盖子目录，例如 runs/ablation/baseline_val.json ----
runs/**/*.json

# ---- 例外：runs/eval_*.json 是报告里 mAP 的证据链（基线 vs 续训 vs 交叉验证），
# ---- 体积小、需要人工核对，因此放行入库。必须写在上面的规则**之后**，
# ---- 否则会被 runs/**/*.json 重新吃掉。
!runs/eval_*.json
